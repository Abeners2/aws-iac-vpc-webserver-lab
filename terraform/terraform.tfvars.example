# Copy to terraform.tfvars (gitignored) before running `terraform apply`
aws_region          = "us-east-1"
project_name        = "aws-iac-web-lab"
environment         = "dev"
vpc_cidr            = "10.20.0.0/16"
public_subnet_cidr  = "10.20.1.0/24"
private_subnet_cidr = "10.20.2.0/24"
# Replace with your real public IP (check via `curl ifconfig.me`)
allowed_ssh_cidr    = "198.51.100.10/32"
instance_type       = "t3.micro"
